#!/usr/bin/env bash
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

list_projects() {
    find ~ -maxdepth 1 -type d,l
    find ~/Projects -mindepth 1 -maxdepth "${TMUXS_PROJECT_DEPTH:-1}" -type d
}

list_sessions() {
    tmux list-sessions -F '#S#{?session_attached, (attached),}' 2>/dev/null
}

case "$1" in
    --list=projects) list_projects; exit 0 ;;
    --list=sessions) list_sessions; exit 0 ;;
esac

if [[ -n "$1" ]]; then
    selected=$1
else
    selected=$(list_projects | fzf \
        --prompt='projects> ' \
        --header='ctrl-s: toggle projects/sessions' \
        --bind "ctrl-s:transform:if [[ \$FZF_PROMPT == 'projects> ' ]]; then echo 'change-prompt(sessions> )+reload($self --list=sessions)'; else echo 'change-prompt(projects> )+reload($self --list=projects)'; fi")
fi

if [[ -z "$selected" ]]; then
    exit 0
fi

# Strip the attached indicator added by list_sessions.
selected=${selected% (attached)}

# An existing tmux session name (picked from the sessions list) isn't a path.
if ! [[ -e "$selected" ]] && tmux has-session -t "$selected" 2> /dev/null; then
    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$selected"
    else
        tmux switch-client -t "$selected"
    fi
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)
selected_path=$({ cd $selected; pwd; })

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c ${selected_path}
    exit 0
fi

if ! tmux has-session -t $selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c ${selected_path}
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t $selected_name
else
    tmux switch-client -t $selected_name
fi
